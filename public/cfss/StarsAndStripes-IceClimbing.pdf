         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Boarding pass. Airline ticket template with sample text and qr code. Air travel concept for travel design or business meetings. Vector paper boarding pass with tear line on transparent background.</rdf:li>
            </rdf:Alt>
